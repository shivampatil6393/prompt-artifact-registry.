# Required for deployment; generate a long random value
SECRET_KEY=replace-with-a-long-random-secret
# Optional: without a key, generation uses a clearly marked mock response
GEMINI_API_KEY=
# Optional: leave blank for local SQLite. Set Supabase PostgreSQL URL in production.
DATABASE_URL=
# Optional for local sample data only (12+ characters)
DEMO_ADMIN_PASSWORD=
